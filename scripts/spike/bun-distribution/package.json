{
  "name": "@mimimilli/spike-bun-distribution",
  "private": true,
  "type": "module",
  "scripts": {
    "deps:windows": "bun install --frozen-lockfile --os=win32 --cpu=x64",
    "smoke:sqlite": "bun run src/run-sqlite-smoke.ts",
    "smoke:server": "bun run src/run-server-smoke.ts",
    "probe:node-server": "bun run src/probes/hono-node-server.ts",
    "probe:sharp": "bun run src/probes/sharp.ts",
    "build:windows": "bun run src/build-windows.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.14.0",
    "better-sqlite3": "12.10.0",
    "hono": "4.7.0",
    "sharp": "0.35.3"
  }
}
