{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-ssr/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "client/tests/visual/**/*.png"
  ],
  "settings": {
    "react": {
      "version": "19.1.0"
    }
  },
  "overrides": [
    {
      "files": ["client/src/app/App.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "jotai",
                "importNames": ["useAtom", "useAtomValue"],
                "message": "App.tsx は Jotai の read API を import しない"
              }
            ],
            "patterns": [
              {
                "group": ["**/features/**/model/atoms", "**/features/**/model/*Atoms"],
                "message": "App.tsx は atom/state モジュールを import しない"
              }
            ]
          }
        ]
      }
    }
  ]
}
