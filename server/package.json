{
  "name": "@mimimilli/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./adapters/fixture": "./src/adapters/fixture/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:real": "node ../scripts/dev-real.mjs -- cross-env PORTLESS_HTTPS=0 PORTLESS_PORT=1355 portless run bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "dlsite-cache": "bun src/dlsiteCacheCli.ts",
    "check": "tsc --noEmit",
    "test": "bun test tests --parallel",
    "smoke:real": "bun tests/helpers/smoke.ts",
    "bench:seed": "bun bench/seed.ts",
    "bench:run": "bun bench/bench.ts",
    "db:generate": "drizzle-kit generate --config drizzle.catalog.config.ts && drizzle-kit generate --config drizzle.user.config.ts"
  },
  "dependencies": {
    "@logtape/file": "^2.3.0",
    "@logtape/logtape": "^2.3.0",
    "@mimimilli/shared": "workspace:*",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "music-metadata": "^11.13.0",
    "sharp": "^0.35.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^25.9.1",
    "bun": "1.3.14",
    "drizzle-kit": "^0.31.9",
    "typescript": "~5.8.3"
  },
  "portless": "api.mimi"
}
